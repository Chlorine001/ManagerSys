<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chlorine.water.mapper.BackNoticeMapper">
    <resultMap id="BaseResultMap" type="com.chlorine.water.entity.BackNotice">
        <!--        <id property="id" column="id" jdbcType="INTEGER"/>-->
        <result property="report" column="text" jdbcType="VARCHAR"/>
    </resultMap>


    <sql id="Base_Column_List">
        id,text
    </sql>

    <!-- 获取该Notice最后一条信息-->
    <select id="getBackNotice" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from back_notice
        ORDER BY
        id DESC LIMIT 1
    </select>


</mapper>
